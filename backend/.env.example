# Environment Variables for Production
# Copy this file to .env and fill in the actual values

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-render-app-name.onrender.com,localhost,127.0.0.1

# Database (Render will provide this)
DATABASE_URL=postgres://user:password@host:port/dbname

# CORS Settings (Update with your frontend domain)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com